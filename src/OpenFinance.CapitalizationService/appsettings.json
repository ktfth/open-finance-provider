{
  "ConnectionStrings": {
    "CapitalizationDb": "Server=#{DB_SERVER}#;Database=OpenFinanceCapitalization;User Id=#{DB_USER}#;Password=#{DB_PASSWORD}#;TrustServerCertificate=#{DB_TRUST_CERT}#;"
  },
  "ConsentService": {
    "BaseUrl": "#{CONSENT_SERVICE_URL}#"
  },
  "Authentication": {
    "Issuer": "open-finance-provider",
    "Audience": "open-finance-api",
    "SigningKey": "#{AUTH_SIGNING_KEY}#"
  },
  "OpenTelemetry": {
    "Endpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
